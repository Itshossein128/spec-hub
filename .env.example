# Optional overrides for docker compose (BookStack).
# Defaults work for local `pnpm run dev` without this file.

TZ=Etc/UTC
BOOKSTACK_PORT=7875
BOOKSTACK_APP_URL=http://localhost:7875
BOOKSTACK_URL=http://localhost:7875

# Override the compose default if you want a unique key:
#   docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:latest appkey
BOOKSTACK_APP_KEY=base64:kWEAOFVuAbz+0ZEF84gfQ7zr72n6rJZpXjC2a98DgSQ=

BOOKSTACK_DB_DATABASE=bookstack
BOOKSTACK_DB_USERNAME=bookstack
BOOKSTACK_DB_PASSWORD=bookstack
BOOKSTACK_DB_ROOT_PASSWORD=mysupersecretrootpassword

# BookStack API token (Settings → API Tokens in the BookStack UI).
# Required for live wiki sync / MCP create/search. Offline fixture sync works without these.
BOOKSTACK_TOKEN_ID=hEL327l1wBRNqnIxCW47UDwKQIsLKSy0
BOOKSTACK_TOKEN_SECRET=YICsgyH71f5TQ8qCIgliAXe0wGBJsqJW
# BookStack UI language (fa = Persian). Disable browser auto-detect so public UI stays Persian.
APP_LANG=fa
APP_AUTO_LANG_PUBLIC=false
