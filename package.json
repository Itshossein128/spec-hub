{
  "name": "agentdoc-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "AgentDoc Bridge — multi-agent software documentation & context hub",
  "scripts": {
    "dev": "pnpm bookstack:up && pnpm --filter @agentdoc/web dev",
    "dev:web": "pnpm --filter @agentdoc/web dev",
    "dev:mcp": "pnpm --filter @agentdoc/mcp-server dev",
    "bookstack:up": "docker compose up -d",
    "bookstack:down": "docker compose down",
    "bookstack:logs": "docker compose logs -f",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @agentdoc/web build && pnpm --filter @agentdoc/mcp-server build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.0"
}
