{
  "name": "spec-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Spec Hub — multi-agent software documentation & context hub",
  "scripts": {
    "dev": "pnpm bookstack:up && pnpm --filter @spec-hub/web dev",
    "dev:web": "pnpm --filter @spec-hub/web dev",
    "dev:mcp": "pnpm --filter @spec-hub/mcp-server dev",
    "bookstack:up": "docker compose up -d",
    "bookstack:down": "docker compose down",
    "bookstack:logs": "docker compose logs -f",
    "bookstack:sync": "pnpm --filter @spec-hub/bookstack-graph exec tsx src/cli.ts sync",
    "bookstack:graph": "pnpm --filter @spec-hub/bookstack-graph exec tsx src/cli.ts graph",
    "bookstack:graph:update": "pnpm --filter @spec-hub/bookstack-graph exec tsx src/cli.ts graph --update",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @spec-hub/web build && pnpm --filter @spec-hub/mcp-server build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.0"
}
